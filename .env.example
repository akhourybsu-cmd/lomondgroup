# ============================================================
# Lomond Appraisal Group — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API

# Safe to expose to the browser. All data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER expose this to the browser. Used only in server-side code.
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ──────────────────────────────────────────────────────────────

# Public site URL (used for metadata and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Operations Module (appointments + routing) ──────────────────────────────
# Google Maps Platform — enable "Geocoding API" and "Routes API" in
# Google Cloud Console, create an API key restricted to those two APIs.
# Server-only: NEVER expose this key to the browser.
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Anthropic API key for AI-assisted PDF appointment extraction.
# Server-only: NEVER expose this key to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default route start location (home base). Used when generating a
# daily route unless overridden per-route.
OPS_DEFAULT_START_ADDRESS="123 Main St, Boston, MA 02108"

# ── Email (Future — Phase 2+) ────────────────────────────────────────────────
# Resend API key for transactional emails
# RESEND_API_KEY=re_your-key-here
# FROM_EMAIL=noreply@yourdomain.com
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── Payments (Phase 7) ───────────────────────────────────────────────────────
# Stripe keys — NEVER expose the secret key to the browser.
# Found in: Stripe Dashboard > Developers > API keys
# Webhook secret: stripe listen --print-secret  (CLI) or Dashboard > Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ── Application URL ───────────────────────────────────────────────────────────
# Used by Stripe checkout success/cancel redirect URLs.
# Set to your production domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
